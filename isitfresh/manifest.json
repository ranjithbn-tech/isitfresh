{
  "manifest_version": 3,
  "name": "isitfresh",
  "version": "1.0.0",
  "description": "Is it fresh? See Rotten Tomatoes ratings instantly when hovering over movies and TV shows on Netflix and Prime Video",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://*.primevideo.com/*",
    "https://*.amazon.com/*",
    "https://ranjithbn-tech.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.com/gp/video/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
